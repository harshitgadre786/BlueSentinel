# BlueSentinel Supabase Authentication & Database Keys
# Replace these with your actual Supabase project credentials from https://supabase.com/dashboard

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Optional: Redirect URL after OAuth (defaults to window.location.origin/workspace)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
