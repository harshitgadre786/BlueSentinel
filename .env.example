# BlueSentinel Supabase & AI Configuration
# When connected via Vercel Supabase Integration, these are automatically provided.

# Supabase Project Credentials (Authentication, Database, & Vector Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Server-Side / Vercel Injected Aliases (Optional / Automatic)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-public-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# OAuth Redirect Base URL (defaults to window.location.origin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google Gemini API for Live RAG Generation
NEXT_PUBLIC_GEMINI_API_KEY=your-gemini-api-key
